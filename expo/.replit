modules = ["nodejs-20"]
[agent]
expertMode = true
integrations = ["javascript_openai_ai_integrations:2.0.0"]

[nix]
channel = "stable-25_05"
packages = ["ffmpeg"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Expo Web"

[[workflows.workflow]]
name = "Expo Web"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run start-web"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3001

[deployment]
deploymentTarget = "static"
build = ["npm", "run", "build-web"]
publicDir = "dist"

[userenv]

[userenv.shared]
EXPO_PUBLIC_AI_INTEGRATIONS_OPENAI_API_KEY = "${AI_INTEGRATIONS_OPENAI_API_KEY}"
EXPO_PUBLIC_AI_INTEGRATIONS_OPENAI_BASE_URL = "${AI_INTEGRATIONS_OPENAI_BASE_URL}"
